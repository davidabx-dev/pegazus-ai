# App Settings
APP_NAME="Pegazus-AI"
DEBUG=True
API_V1_STR="/api/v1"

# Security / JWT Settings
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings (PostgreSQL do Docker Compose)
DATABASE_URL="postgresql://pegazus:pegazus_password@localhost:5432/pegazus_db"

# Vector Store Settings
QDRANT_LOCATION=":memory:"

# LLM & Embedding Settings
# LLM_PROVIDER options: "groq", "google", "fake"
LLM_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GOOGLE_API_KEY="your_google_api_key_here"
GROQ_MODEL_NAME="llama-3.3-70b-versatile"
GOOGLE_MODEL_NAME="gemini-1.5-flash"

# Embedding settings: "fastembed", "fake"
EMBEDDING_PROVIDER="fastembed"
